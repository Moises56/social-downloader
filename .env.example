API_PORT=3005
WEB_ORIGIN=http://localhost:4205
# Homebrew suele ir semanas por detras, y las redes sociales rompen los extractores a
# menudo. Si TikTok o Instagram fallan, apunta esto a un yt-dlp reciente, p.ej. un venv:
#   python3 -m venv ~/.local/share/yt-dlp-venv
#   ~/.local/share/yt-dlp-venv/bin/pip install "yt-dlp" "curl-cffi>=0.10,<0.16"
YTDLP_BINARY=yt-dlp
# Ruta al binario. Déjalo VACÍO para autodetección: se elige el primer FFmpeg que
# soporte drawtext (Homebrew ya no enlaza libfreetype, así que `ffmpeg` a secas
# normalmente NO sirve para renderizar texto).
FFMPEG_BINARY=
ANALYSIS_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=900000
MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=2
# Cookies del navegador para plataformas que exigen sesion (instagram, facebook, tiktok).
# Valores: chrome | safari | firefox | edge | brave  (opcionalmente perfil: chrome:Default)
YTDLP_COOKIES_FROM_BROWSER=
# Cliente que yt-dlp imita. Vacio = automatico (TikTok ya lo pide por su cuenta cuando hay
# un objetivo disponible). Requiere curl_cffi en el entorno de yt-dlp; comprueba con
# `yt-dlp --list-impersonate-targets`.
YTDLP_IMPERSONATE=
# Proxy para yt-dlp. TikTok limita por IP: desde una sola conexion domestica bastan ~10
# peticiones para quedar bloqueado un rato. Los sitios que descargan TikTok de forma
# sostenida no usan otra tecnica, usan muchas IPs. Ej: http://user:pass@host:puerto
YTDLP_PROXY=
# Ruta de extraccion alternativa (API de la app movil, devuelve sin marca de agua):
#   tiktok:api_hostname=api22-normal-c-useast2a.tiktokv.com
YTDLP_EXTRACTOR_ARGS=
